---

---

<footer>
  <!-- Topo -->
  <div class="topo">
    <img
      src="/assets/images/logo-white.png"
      class="logo"
      alt="Logo Marsura Digital"
    />
    <div class="quadrinho">
      <img src="/assets/images/icon-cadeado.png" alt="Ícone de Cadeado" />
      <div class="texto">
        <h3>Site Seguro</h3>
        <p>Navegação criptografada</p>
      </div>
    </div>
  </div>

  <!-- Section Legal & Contato (Adicionado) -->
  <div
    class="legal-info"
    style="display: flex; flex-wrap: wrap; justify-content: space-between; text-align: center; padding: 20px; color: #fff; width: 100%; max-width: 1320px; margin: 0 auto; margin-bottom: 20px;"
  >
    <div
      class="info-bloco"
      style="text-align: left; flex: 1; min-width: 250px;"
    >
      <h4 style="color: #fff; font-size: 16px; margin-bottom: 10px;">
        Contato
      </h4>
      <p
        style="margin: 0 0 10px 0; font-size: 14px; display: flex; align-items: center; justify-content: flex-start; gap: 10px;"
      >
        <img
          src="/assets/images/icon-email-white.webp"
          alt="Ícone de Email"
          style="width: 16px; height: auto;"
        />
        <a
          href="mailto:contato@marsuradigital.com.br"
          style="color: #fff; text-decoration: underline;"
          >contato@marsuradigital.com.br</a
        >
      </p>
      <p
        style="margin: 0; font-size: 14px; display: flex; align-items: center; justify-content: flex-start; gap: 10px;"
      >
        <img
          src="/assets/images/icon-telefone.png"
          alt="Ícone de Telefone"
          style="width: 16px; height: auto;"
        />
        <a
          href="tel:+5518998022266"
          style="color: #fff; text-decoration: underline;">18 99802 2266</a
        >
      </p>
    </div>
    <div
      class="info-bloco"
      style="text-align: center; flex: 1; min-width: 250px;"
    >
      <h4 style="color: #fff; font-size: 16px; margin-bottom: 10px;">
        Informações da Empresa
      </h4>
      <p style="color: #fff; margin: 0; font-size: 14px;">
        Razão Social: Marsura Digital Marketing Ltda.
      </p>
      <p style="color: #fff; margin: 0; font-size: 14px;">
        CNPJ: 00.000.000/0001-00
      </p>
      <address style="margin: 0; font-size: 14px; font-style: normal;">
        Av. Paulista, 1000 - Bela Vista, São Paulo - SP, 01310-100
      </address>
    </div>
    <div
      class="info-bloco"
      style="display: flex; flex-direction: column; gap: 10px; align-items: flex-end; text-align: right; flex: 1; min-width: 250px;"
    >
      <h4 style="color: #fff; font-size: 16px; margin-bottom: 0px;">
        Políticas
      </h4>
      <a
        href="/politica-de-privacidade"
        style="color: #fff; font-size: 14px; text-decoration: underline;"
        >Política de Privacidade</a
      >
      <a
        href="/termos-de-uso"
        style="color: #fff; font-size: 14px; text-decoration: underline;"
        >Termos de Uso</a
      >
    </div>
  </div>

  <!-- Copy -->
  <div class="copy">
    <p>
      ©2024 Marsura Digital - Todos os Direitos Reservados.
      <a href="https://creathor.com.br" class="creathor"
        >Criado por
        <img
          src="/assets/images/logo-creathor.png"
          class="logo-creathor"
          alt="Logo Creathor"
        />
      </a>
    </p>
    <div class="sociais">
      <a
        href="https://www.instagram.com/marsuradigital/"
        aria-label="Acessar Instagram"
      >
        <img src="/assets/images/icon-instagram-white.jpg" alt="Instagram" />
      </a>
      <a
        href="https://www.facebook.com/MarsuraDigital"
        aria-label="Acessar Facebook"
      >
        <img src="/assets/images/icon-facebook-white.jpg" alt="Facebook" />
      </a>
    </div>
  </div>
</footer>

<style>
  @media screen and (max-width: 800px) {
    .legal-info {
      flex-direction: column !important;
      align-items: center !important;
      gap: 30px !important;
    }
    .info-bloco {
      text-align: center !important;
      align-items: center !important;
      width: 100% !important;
    }
    .info-bloco p {
      justify-content: center !important;
    }
  }
</style>
