---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
---

<Layout title="Tráfego Pago para Clínicas">
  <!-- ***** Preloader Start ***** -->
  <div id="js-preloader" class="js-preloader">
    <div class="preloader-inner">
      <span class="dot"></span>
      <div class="dots">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </div>
  <!-- ***** Preloader End ***** -->

  <Header />

  <div id="contact" class="presentation section">
    <div class="container">
      <div class="row">
        <div
          class="col-lg-6 align-self-center wow fadeInLeft"
          data-wow-duration="0.5s"
          data-wow-delay="0.25s"
        >
          <div class="section-heading">
            <div class="itens">
              <div class="item">
                <img
                  src="/assets/images/icon-dinheiro.png"
                  alt="Icon Dinheiro"
                />
                <p>+ Faturamento</p>
              </div>
              <div class="item">
                <img
                  src="/assets/images/icon-resultado.png"
                  alt="Icon Resultado"
                />
                <p>+ Resultado</p>
              </div>
            </div>
            <h2>Atraia mais <span>clientes</span> para sua clínica</h2>
            <p>
              Alcance novos pacientes e aumente o faturamento da sua clínica com
              nosso método Marsura Digital.
            </p>
          </div>
        </div>
        <div
          class="section-form col-lg-6 wow fadeInRight"
          data-wow-duration="0.5s"
          data-wow-delay="0.25s"
        >
          <!-- Notificação -->
          <div id="notification" class="notification"></div>

          <form id="contactForm" class="form">
            <div class="icone">
              <img
                src="/assets/images/icon-faturamento.png"
                alt="Icon Faturamento"
              />
            </div>
            <div class="titulo">
              <h2>Converse com um especialista <span>Marsura</span></h2>
              <p>
                Preencha o formulário abaixo e descubra como aumentar o fluxo de
                pacientes na sua clínica:
              </p>
            </div>
            <div class="input">
              <img src="/assets/images/icon-user.png" alt="User" />
              <input
                id="nameInput"
                type="text"
                autocomplete="name"
                placeholder="Nome completo"
                required
              />
            </div>
            <div class="input">
              <img src="/assets/images/icon-whatsapp.png" alt="Whatsapp" />
              <input
                id="telephoneInput"
                type="tel"
                autocomplete="tel"
                placeholder="(00) 00000-0000"
                required
              />
            </div>
            <div class="input">
              <img src="/assets/images/icon-email.png" alt="Email" />
              <input
                id="emailInput"
                type="email"
                autocomplete="email"
                placeholder="E-mail"
                required
              />
            </div>
            <textarea
              rows="4"
              id="mesageTextArea"
              placeholder="Digite sua mensagem"></textarea>
            <div style="margin-bottom: 15px;">
              <input type="checkbox" id="consentCheckbox" required />
              <label for="consentCheckbox" style="font-size: 12px;">
                Li e concordo com a <a
                  href="/politica-de-privacidade"
                  target="_blank"
                  style="text-decoration: underline; color: #03a4ed;"
                  >Política de Privacidade</a
                >.
              </label>
            </div>
            <button type="submit">QUERO AUMENTAR MEU FATURAMENTO!</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Seção Referência -->
  <section class="referencia">
    <div class="linha"></div>
    <div class="quadro">
      <div class="item">
        <div class="texto">
          <h3 style="display: flex; justify-content: center; gap: 8px;">
            <span>+R$</span>
            <span
              id="count1"
              style="width: 10.5ch; text-align: left; font-variant-numeric: tabular-nums;"
              >2.000.000</span
            >
          </h3>
          <p>Investidos em Tráfego Pago</p>
        </div>
      </div>
      <div class="item">
        <div class="texto">
          <h3 style="display: flex; justify-content: center; gap: 8px;">
            <span>+R$</span>
            <span
              id="count2"
              style="width: 10.5ch; text-align: left; font-variant-numeric: tabular-nums;"
              >1.000.000</span
            >
          </h3>
          <p>Leads Gerados</p>
        </div>
      </div>
      <div class="item">
        <div class="texto">
          <h3 style="display: flex; justify-content: center; gap: 8px;">
            <span>+R$</span>
            <span
              id="count3"
              style="width: 10.5ch; text-align: left; font-variant-numeric: tabular-nums;"
              >10.000.000</span
            >
          </h3>
          <p>Faturamento</p>
        </div>
      </div>
    </div>
  </section>

  <section class="parceiros">
    <!-- Título -->
    <div class="titulo">
      <h2>Negócios que <span>crescem </span>conosco</h2>
      <p>
        Descubra como nossas soluções de marketing digital estão impulsionando o
        crescimento de clínicas em todo o país.
      </p>
    </div>
    <!-- Slide -->
    <div class="slide">
      <div class="itens">
        {
          Array.from({ length: 12 }).map(() => (
            <>
              <img src="/assets/images/clientes-1.jpg" alt="Cliente" />
              <img src="/assets/images/clientes-2.jpg" alt="Cliente" />
              <img src="/assets/images/clientes-3.jpg" alt="Cliente" />
              <img src="/assets/images/clientes-4.jpg" alt="Cliente" />
              <img src="/assets/images/clientes-5.jpg" alt="Cliente" />
              <img src="/assets/images/clientes-6.jpg" alt="Cliente" />
              <img src="/assets/images/clientes-7.jpg" alt="Cliente" />
              <img src="/assets/images/clientes-8.jpg" alt="Cliente" />
            </>
          ))
        }
      </div>
    </div>
  </section>

  <div id="about" class="about-us section">
    <div class="container">
      <div class="row">
        <div class="col-lg-4">
          <div
            class="left-image wow fadeIn"
            data-wow-duration="1s"
            data-wow-delay="0.2s"
          >
            <img
              src="/assets/images/about-left-image.png"
              alt="person graphic"
            />
          </div>
        </div>
        <div class="col-lg-8 align-self-center">
          <div class="services">
            <div class="row">
              <div class="col-lg-6">
                <div
                  class="item wow fadeIn"
                  data-wow-duration="1s"
                  data-wow-delay="0.2s"
                >
                  <div class="icon">
                    <img
                      src="/assets/images/service-icon-01.jpg"
                      alt="reporting"
                    />
                  </div>
                  <div class="right-text">
                    <h4>Gestão De Tráfego</h4>
                    <p>
                      Gerenciamos suas campanhas de tráfego pago com precisão,
                      otimizando anúncios para alcançar o público certo e
                      maximizar seu faturamento.
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-lg-6">
                <div
                  class="item wow fadeIn"
                  data-wow-duration="1s"
                  data-wow-delay="0.2s"
                >
                  <div class="icon">
                    <img
                      src="/assets/images/service-icon-02.jpg"
                      alt="design icon"
                    />
                  </div>
                  <div class="right-text">
                    <h4>Designer</h4>
                    <p>
                      Transformamos suas ideias em visuais impactantes. Nosso
                      time de designers cria peças gráficas que comunicam sua
                      marca.
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-lg-6">
                <div
                  class="item wow fadeIn"
                  data-wow-duration="1s"
                  data-wow-delay="0.2s"
                >
                  <div class="icon">
                    <img
                      src="/assets/images/service-icon-03.jpg"
                      alt="web design icon"
                    />
                  </div>
                  <div class="right-text">
                    <h4>Web Designer</h4>
                    <p>
                      Criamos sites modernos e responsivos que oferecem uma
                      experiência de usuário excepcional.
                    </p>
                  </div>
                </div>
              </div>
              <div class="col-lg-6">
                <div
                  class="item wow fadeIn"
                  data-wow-duration="1s"
                  data-wow-delay="0.2s"
                >
                  <div class="icon">
                    <img
                      src="/assets/images/service-icon-04.jpg"
                      alt="automation icon"
                    />
                  </div>
                  <div class="right-text">
                    <h4>Automação</h4>
                    <p>
                      Automatizamos seus processos de marketing para aumentar a
                      eficiência e gerar resultados consistentes.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section id="sobre-nos" class="sobre-nos">
    <div class="imagem">
      <img
        src="/assets/images/sobre-nos.png"
        class="fotos"
        alt="Sobre nós Marsura Digital"
      />
    </div>
    <div class="texto">
      <h3>Sobre Nós</h3>
      <h2>Marsura</h2>
      <p>
        Na Marsura, acreditamos no poder da transformação digital para
        impulsionar negócios e alcançar resultados extraordinários. Somos uma
        agência especializada em tráfego pago, design, desenvolvimento web e
        automação de marketing, oferecendo soluções personalizadas para atender
        às necessidades únicas de cada cliente.
      </p>
    </div>
  </section>

  <section class="faixas">
    <div class="faixa dois"></div>
    <div class="faixa">
      <div class="itens">
        {
          Array.from({ length: 12 }).map(() => (
            <>
              <p>Automações</p>
              <img src="/assets/images/icon-check.jpg" alt="check" />
              <p>Resultados</p>
              <img src="/assets/images/icon-check.jpg" alt="check" />
              <p>Transparência</p>
              <img src="/assets/images/icon-check.jpg" alt="check" />
              <p>Parceria</p>
              <img src="/assets/images/icon-check.jpg" alt="check" />
            </>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Seção Avaliações -->
  <section class="avaliacoes">
    <!-- Título -->
    <div class="titulo">
      <div class="texto">
        <h3>Agência bem avaliada</h3>
        <h2>
          Temos uma reputação global por fornecer serviços digitais
          excepcionais.
        </h2>
      </div>
      <div class="botoes">
        <a
          href="https://www.instagram.com/marsuradigital/"
          aria-label="Acessar Instagram"
        >
          <img src="/assets/images/icon-instagram.png" alt="Instagram" />
          <p>Instagram</p>
        </a>
        <a
          href="https://www.facebook.com/MarsuraDigital"
          aria-label="Acessar Facebook"
        >
          <img src="/assets/images/icon-facebook.png" alt="Facebook" />
          <p>Facebook</p>
        </a>
      </div>
    </div>
    <!-- Itens -->
    <div class="slide">
      <div class="itens">
        {
          Array.from({ length: 12 }).map(() => (
            <>
              <div class="item">
                <img
                  src="/assets/images/depoimento-1.jpg"
                  class="foto"
                  alt="Depoimento 1"
                />
              </div>
              <div class="item">
                <img
                  src="/assets/images/depoimento-2.jpg"
                  class="foto"
                  alt="Depoimento 2"
                />
              </div>
              <div class="item">
                <img
                  src="/assets/images/depoimento-3.jpg"
                  class="foto"
                  alt="Depoimento 3"
                />
              </div>
              <div class="item">
                <img
                  src="/assets/images/depoimento-4.jpg"
                  class="foto"
                  alt="Depoimento 4"
                />
              </div>
            </>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sobre">
    <div class="imagem"></div>
    <div class="titulo">
      <img
        class="logo"
        src="/assets/images/subido-logo.png"
        alt="Subido Logo"
      />
      <h3>Estamos entre os melhores</h3>
      <p>
        Nosso compromisso com a excelência nos motiva a estar entre os melhores
        especialistas em tráfego pago do país. Por isso, seguimos aprendendo com
        as maiores referências do mercado para oferecer sempre o melhor
        resultado para nossos clientes.
      </p>
    </div>
  </section>

  <Footer />
  <CookieBanner />
</Layout>
